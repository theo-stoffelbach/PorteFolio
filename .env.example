# Configuration du Portfolio - Exemple
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# ========================================
# CONFIGURATION ADMIN
# ========================================

# Email de l'administrateur
ADMIN_EMAIL=admin@portfolio.com

# Hash du mot de passe admin (généré avec bcrypt)
# Pour générer un hash : docker exec portfolio npm run create-admin
# ⚠️ NE JAMAIS mettre le mot de passe en clair ici !
ADMIN_PASSWORD_HASH=$2b$10$examplehashdonotusethisinproduction

# ========================================
# CONFIGURATION JWT
# ========================================

# Secret pour signer les tokens JWT (chaîne aléatoire forte)
# Générer avec : openssl rand -base64 32
JWT_SECRET=votre_secret_jwt_tres_secure_changez_moi

# Durée de validité du token (en secondes)
# Par défaut : 604800 = 7 jours
JWT_EXPIRES_IN=604800

# ========================================
# ENVIRONNEMENT
# ========================================

# development | production
NODE_ENV=production
